# Environment variables / secrets
# Ignore .env and all variants (.env.local, .env.production, …) but keep the
# committed template. Prevents accidentally committing the GEMINI/NAVER/KIS keys.
.env
.env.*
!.env.example
kis_token_cache.json

# Python cache
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Runtime outputs (incl. crolling.py news_gemini_result.json, pipeline CSV/JSON)
outputs/
*.log

# Fresh OHLCV cache, regenerated per run
fresh_ohlcv.parquet

# Local tool state
.claude/

# Virtual environments / OS
venv/
.venv/
venv-timesfm/
.DS_Store

# Keep shared_*.parquet tracked for reproducibility.
# Do not reintroduce a broad *.parquet ignore rule.
