# ============================================================
# .env.example  —  실제 값이 아닌 placeholder 만 담겨 있습니다.
# 사용법: 이 파일을 복사해 ".env" 로 저장하고 값을 채우세요.
#   (Windows)  copy .env.example .env
#   (mac/linux) cp .env.example .env
# .env 는 .gitignore 로 무시되므로 절대 커밋되지 않습니다.
# ============================================================

# --- KIS(한국투자증권) 모의투자 OpenAPI [필수: 기본 파이프라인] ---
APP_KEY=your_kis_app_key_here
APP_SECRET=your_kis_app_secret_here

# --- 뉴스 수집(네이버 검색 API) [LLM 단계에서만 필요] ---
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# --- LLM 근거 설명 [LLM 단계에서만 필요] ---
# OpenAI 사용 시
OPENAI_API_KEY=your_openai_api_key_here
# Gemini(google-genai) 사용 시 (genai.Client() 가 자동으로 읽음)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here   # GEMINI_API_KEY 대신 사용 가능

# ============================================================
# (선택) 동작 튜닝용 환경변수 — 미설정 시 코드 기본값 사용
# ============================================================
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-1.5-flash
# KOSPI200_POOL_SOURCE=
# TOP_SORT_COLUMN=
# KIS_MAX_RETRIES=3
# KIS_REQUEST_SLEEP_SECONDS=0.3
# KIS_SUPPLY_SLEEP_SECONDS=0.3
# IP_DEBUG_SUPPLY=
